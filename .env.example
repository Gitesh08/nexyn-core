# Backend Configuration
COGNEE_API_KEY=your_cognee_api_key_here
COGNEE_URL=your_cognee_url_here
COGNEE_TENANT_ID=your_tenant_id_here
COGNEE_USER_ID=your_user_id_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
ENVIRONMENT=development
PORT=8000
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_nvidia_nim_api_key_here
EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Remote Postgres Logs Configuration
NEXYN_LOGS_DB_HOST=postgresql-nexyn.alwaysdata.net
NEXYN_LOGS_DB_PORT=5432
NEXYN_LOGS_DB_USER=nexyn
NEXYN_LOGS_DB_PASSWORD=your_password_here
NEXYN_LOGS_DB_NAME=nexyn_logs
